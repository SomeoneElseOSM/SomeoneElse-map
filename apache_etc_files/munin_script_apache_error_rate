#!/bin/sh

# Derived with few changes from
# https://github.com/dc2447/munin-apache-error-rate/blob/master/apache_error_rate
# (no licence declared there)
# via
# https://serverfault.com/questions/279100/best-plugin-for-tracking-apache-response-codes-with-munin

# Note that:
# 1) It needs to run as adm so it can read apache logs.
# The config I've named munin_conf_apache_error_rate in /etc/munin/plugin-conf.d/ does that.
# 2) Apache log format is configurable.
# One option is: awk '{print $9 }' | grep -c "${code}"
# But elsewhere I use:  awk -F\" '{print $3}' | sed "s/^ *//"  | sed "s/ .*//"  | grep -c "${code}"
# 3) If fail2ban is configured this plugin won't see those failed accesses because they don't get this far.

# If run with the "config"-parameter, give out information on how the
# graphs should look.

mystatuscodes="200 304 400 401 403 404 500 503 504"
myloglines="10000"
myaccesslog="/var/log/apache2/access.log"

if [ "$1" = "config" ]; then

        echo 'graph_title Apache Error Rate '
        echo 'graph_category apache'

        echo 'graph_args --base 1000 -l 0'
        echo 'graph_vlabel rate'
        echo 'graph_scale no'

	for code in $mystatuscodes
	    do
	        echo "error_${code}.label ${code} Errors:"
                echo "error_${code}.type GAUGE"
	    done

        echo 'graph_info The number of apache errors in logs'
        exit 0
fi

        for code in $mystatuscodes
                do
		echo -n "error_${code}.value "
		tail -${myloglines} ${myaccesslog} | grep -iv munin | awk '{print $9 }' | grep -c "${code}"
        done

exit 0
